-- Batch1: Black Hole Dimension Builder
-- This script creates the Black Hole dimension geometry in the workspace.
-- It will be loaded via loadstring from GitHub by AdminCommands.
-- createPocketDimension2 handles repositioning, recoloring, and visual effects.

-- Helper function to create parts
local function p(size, pos, color, material, transparency, shape)
	local part = Instance.new("Part")
	part.Size = size
	part.Position = pos
	part.Anchored = true
	part.BrickColor = BrickColor.new(color)
	part.Material = material
	if transparency then
		part.Transparency = transparency
	end
	if shape then
		part.Shape = shape
	end
	part.Parent = workspace
	return part
end

