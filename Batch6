-- Auto-generated MapSpawner LocalScript
-- Creates map parts entirely from code - no Workspace or ReplicatedStorage parts needed

local function getMaterial(num)
    local ok, mat = pcall(function() return Enum.Material:GetEnumItem(num) end)
    if ok and mat then return mat end
    return Enum.Material.Plastic
end

local function buildCFrame(cf)
    return CFrame.new(cf[1],cf[2],cf[3],cf[4],cf[5],cf[6],cf[7],cf[8],cf[9],cf[10],cf[11],cf[12])
end

local function split(str, sep)
    local parts = {}
    for s in str:gmatch("[^" .. sep .. "]+") do
        table.insert(parts, s)
    end
    return parts
end

local function splitNum(str)
    local parts = {}
    for s in str:gmatch("[^,]+") do
        table.insert(parts, tonumber(s) or 0)
    end
    return parts
end

-- Ensure the model exists
local model = workspace:FindFirstChild("MyCustomMap")
if not model then
    model = Instance.new("Model")
    model.Name = "MyCustomMap"
    model.Parent = workspace
end

local count = 0
for _, line in ipairs(DATA) do
    local f = split(line, "|")
    local cn = f[1]
    local name = f[2]
    local cf = splitNum(f[3])
    local sz = splitNum(f[4])
    local col = splitNum(f[5])
    local matNum = tonumber(f[6]) or 256
    local trans = tonumber(f[7]) or 0
    local cc = f[8] == "1"
    local cq = f[9] == "1"
    local ct = f[10] == "1"
    local anchored = f[11] == "1"
    local ref = tonumber(f[12]) or 0
    local cs = f[13] == "1"
    
    local actualClass = "Part"
    if cn == "M" then actualClass = "MeshPart"
    elseif cn == "U" then actualClass = "Part"
    elseif cn == "S" then actualClass = "Seat"
    elseif cn == "L" then actualClass = "SpawnLocation"
    elseif cn == "W" then actualClass = "WedgePart"
    elseif cn == "C" then actualClass = "CornerWedgePart"
    elseif cn == "T" then actualClass = "TrussPart"
    end
    
    local part = Instance.new(actualClass)
    part.Name = name
    part.CFrame = buildCFrame(cf)
    part.Size = Vector3.new(sz[1], sz[2], sz[3])
    part.Color = Color3.new(col[1], col[2], col[3])
    part.Material = getMaterial(matNum)
    part.Transparency = trans
    part.CanCollide = cc
    part.CanQuery = cq
    part.CanTouch = ct
    part.Anchored = anchored
    part.Reflectance = ref
    part.CastShadow = cs
    
    local idx = 14
    if cn == "M" then
        local mid = f[14] or ""
        local tid = f[15] or ""
        if mid ~= "" then part.MeshId = mid end
        if tid ~= "" then part.TextureId = tid end
        idx = 16
    end
    
    -- Children
    for i = idx, #f do
        local childStr = f[i]
        if childStr:sub(1, 3) == "SM:" then
            local cf2 = split(childStr:sub(4), ":")
            local mesh = Instance.new("SpecialMesh")
            mesh.Name = cf2[1] or "Mesh"
            mesh.MeshId = cf2[2] or ""
            mesh.TextureId = cf2[3] or ""
            local mt = cf2[4] or "Brick"
            if mt == "FileMesh" then mesh.MeshType = Enum.MeshType.FileMesh
            elseif mt == "Head" then mesh.MeshType = Enum.MeshType.Head
            elseif mt == "Sphere" then mesh.MeshType = Enum.MeshType.Sphere
            elseif mt == "Cylinder" then mesh.MeshType = Enum.MeshType.Cylinder
            elseif mt == "Brick" then mesh.MeshType = Enum.MeshType.Brick
            elseif mt == "Wedge" then mesh.MeshType = Enum.MeshType.Wedge
            elseif mt == "Torso" then mesh.MeshType = Enum.MeshType.Torso
            else mesh.MeshType = Enum.MeshType.Brick end
            local sc = splitNum(cf2[5] or "1,1,1")
            local of = splitNum(cf2[6] or "0,0,0")
            mesh.Scale = Vector3.new(sc[1],sc[2],sc[3])
            mesh.Offset = Vector3.new(of[1],of[2],of[3])
            mesh.Parent = part
        elseif childStr:sub(1, 3) == "CM:" then
            local cf2 = split(childStr:sub(4), ":")
            local mesh = Instance.new("CylinderMesh")
            mesh.Name = cf2[1] or "Mesh"
            local sc = splitNum(cf2[2] or "1,1,1")
            local of = splitNum(cf2[3] or "0,0,0")
            mesh.Scale = Vector3.new(sc[1],sc[2],sc[3])
            mesh.Offset = Vector3.new(of[1],of[2],of[3])
            mesh.Parent = part
        elseif childStr:sub(1, 3) == "AT:" then
            local cf2 = split(childStr:sub(4), ":")
            local att = Instance.new("Attachment")
            att.Name = cf2[1] or "Attachment"
            local v = splitNum(cf2[2] or "0,0,0,0,0,0")
            att.CFrame = CFrame.new(v[1],v[2],v[3]) * CFrame.Angles(v[4],v[5],v[6])
            att.Parent = part
        elseif childStr:sub(1, 3) == "PE:" then
            local cf2 = split(childStr:sub(4), ":")
            local pe = Instance.new("ParticleEmitter")
            pe.Name = cf2[1] or "ParticleEmitter"
            pe.Texture = cf2[2] or ""
            pe.Enabled = cf2[3] == "1"
            pe.Rate = tonumber(cf2[4]) or 0
            local ltMin, ltMax = tonumber(cf2[5]) or 0, tonumber(cf2[6]) or 0
            local spMin, spMax = tonumber(cf2[7]) or 0, tonumber(cf2[8]) or 0
            pe.Lifetime = NumberRange.new(ltMin, ltMax)
            pe.Speed = NumberRange.new(spMin, spMax)
            pe.Parent = part
        elseif childStr:sub(1, 3) == "BM:" then
            local cf2 = split(childStr:sub(4), ":")
            local beam = Instance.new("Beam")
            beam.Name = cf2[1] or "Beam"
            beam.Texture = cf2[2] or ""
            beam.Width0 = tonumber(cf2[3]) or 0
            beam.Width1 = tonumber(cf2[4]) or 0
            beam.Parent = part
        end
    end
    
    if cn == "L" then
        part.Parent = workspace
    else
        part.Parent = model
    end
    
    count = count + 1
end

print("[MapSpawner] Created " .. count .. " parts")
