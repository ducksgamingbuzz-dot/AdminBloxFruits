-- Helper: fuzzy match fighting style name (auto-correction)
local function matchFightingStyle(input)
	input = input:lower()
	-- Exact match first
	for key, serverStr in pairs(fightingStyles) do
		if key:lower() == input then return key, serverStr end
	end
	-- Partial: input is substring of key
	for key, serverStr in pairs(fightingStyles) do
		if key:lower():find(input, 1, true) then return key, serverStr end
	end
	-- Partial: key is substring of input
	for key, serverStr in pairs(fightingStyles) do
		if input:find(key:lower(), 1, true) then return key, serverStr end
	end
	return nil, nil
end

