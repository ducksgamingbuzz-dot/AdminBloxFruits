local function gotoPlayerPartial(query)
	query = query:lower()
	local targetPlayer = nil

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local nameLower = p.Name:lower()
			local displayLower = p.DisplayName and p.DisplayName:lower() or ""

			if nameLower:find(query) or displayLower:find(query) then
				targetPlayer = p
				break
			end
		end
