-- Helper: tween the player's character to a target Y height
local function tweenPlayerToHeight(targetHeight)
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local currentY = hrp.Position.Y
	local deltaY = targetHeight - currentY
	if math.abs(deltaY) < 1 then return end -- already at height

	-- Anchor the HRP to prevent physics interference during tween
	local wasAnchored = hrp.Anchored
	hrp.Anchored = true

	local startCFrame = hrp.CFrame
	local endCFrame = startCFrame * CFrame.new(0, deltaY, 0)

	local tweenInfo = TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local tween = TweenService:Create(hrp, tweenInfo, {CFrame = endCFrame})
	tween:Play()
	tween.Completed:Wait()

	hrp.Anchored = wasAnchored
end

-- Auto M1 Punch state
local autoPunchActive = false

local function getNil(name, class)
	for _, v in pairs(getnilinstances()) do
