		if value then
			local raidName = matchRaidName(value)
			if raidName then
				print("Auto-corrected '" .. value .. "' to raid: " .. raidName)
				local commF = getCommF()
				if commF then
					local success, err = pcall(function()
						commF:InvokeServer("RaidsNpc", "Select", raidName)
					end)
					if success then
						print("Raid selected: " .. raidName)
					else
						warn("Failed to select raid: " .. tostring(err))
					end
				else
					warn("CommF_ remote not found!")
				end
			else
				local valid = {}
				for name, _ in pairs(validRaids) do table.insert(valid, name) end
				print("Invalid raid name! No match for '" .. value .. "'. Valid raids: " .. table.concat(valid, ", "))
			end
		else
			print("Usage: /raid [name] (auto-corrects partial names, e.g., /raid flame, /raid ic)")
		end
		return
	end

