-- Function to play a dimension sound
local function playDimensionSound(soundId)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(soundId)
	sound.Volume = 1
	sound.Parent = workspace
	sound:Play()
	sound.Ended:Connect(function()
		if sound and sound.Parent then sound:Destroy() end
	end)
	task.delay(30, function()
		if sound and sound.Parent then sound:Destroy() end
	end)
end

-- Function to show a spinning image overlay for a duration (seconds)
local function showSpinningImageOverlay(imageId, duration)
	local pGui = player:FindFirstChild("PlayerGui")
	if not pGui then return end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "DimensionImageOverlay"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = pGui

	local imageLabel = Instance.new("ImageLabel")
	imageLabel.Size = UDim2.new(0, 300, 0, 300)
	imageLabel.Position = UDim2.new(0.5, -150, 0.5, -150)
	imageLabel.BackgroundTransparency = 1
	imageLabel.Image = "rbxassetid://" .. tostring(imageId)
	imageLabel.Parent = screenGui

	local tweenService = game:GetService("TweenService")
	local runService = game:GetService("RunService")
	local startTime = tick()
	local connection

	connection = runService.RenderStepped:Connect(function()
		local elapsed = tick() - startTime
		if elapsed >= duration then
			connection:Disconnect()
			local fadeTween = tweenService:Create(imageLabel, TweenInfo.new(0.3), {ImageTransparency = 1})
			fadeTween:Play()
			fadeTween.Completed:Wait()
			if screenGui and screenGui.Parent then screenGui:Destroy() end
			return
		end
		imageLabel.Rotation = (elapsed / duration) * 720
		local scaleProgress
		if elapsed < duration * 0.3 then
			scaleProgress = elapsed / (duration * 0.3)
		else
			scaleProgress = 1 - ((elapsed - duration * 0.3) / (duration * 0.7))
		end
		local size = math.floor(200 + scaleProgress * 200)
		imageLabel.Size = UDim2.new(0, size, 0, size)
		imageLabel.Position = UDim2.new(0.5, -size / 2, 0.5, -size / 2)
	end)
end

