-- Function to give the Teleport/Break Tool
local function giveDimensionTool()
	-- Remove any existing DimensionTP tool so a fresh one can be created
	local existingBackpack = player.Backpack:FindFirstChild("DimensionTP")
	if existingBackpack then existingBackpack:Destroy() end
	if player.Character then
		local existingChar = player.Character:FindFirstChild("DimensionTP")
		if existingChar then existingChar:Destroy() end
	end

	toolInstance = Instance.new("Tool")
	toolInstance.Name = "DimensionTP"
	toolInstance.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 1, 1)
	handle.BrickColor = BrickColor.new("Cyan")
	handle.Material = Enum.Material.Neon
	handle.Parent = toolInstance

	-- State tracking for toggle behavior: false = teleport inside, true = destroy dimension and reset
	local isInside = false

	toolInstance.Activated:Connect(function()
		local char = player.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then return end

		if not isInside then
			-- Save original position before teleporting into the dimension
			savedPosition = char.HumanoidRootPart.CFrame
			-- Teleport into the dimension
			char.HumanoidRootPart.CFrame = CFrame.new(currentDimensionPos + Vector3.new(0, 150, 0))
			if currentDimensionType == "blackhole" then
				setupBlackHoleLighting()
			else
				setupCosmicLighting()
			end
			-- Play enter sound
			playDimensionSound(116866873116581)
			-- Show spinning image overlay for 2 seconds
			showSpinningImageOverlay(1329924384, 2)
			-- Show welcome message that fades after 5 seconds
			local welcomeText = currentDimensionType == "blackhole" and "Welcome To Black Hole Dimension" or "Welcome To Ciphers Dimension"
			showWelcomeMessage(welcomeText, 5)
			isInside = true
			toolInstance.ToolTip = "Click again to collapse dimension"
			startDimensionContainment()
			print("Teleported inside the God Palace Dimension!")
		else
			-- Break/Disappear the dimension and return player back down
			if currentDimensionFolder then
				currentDimensionFolder:Destroy()
				currentDimensionFolder = nil
			end

			-- Reset lighting to default
			Lighting.Ambient = Color3.fromRGB(128, 128, 128)
			Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
			Lighting.Brightness = 1
			Lighting.ClockTime = 14
			for _, child in ipairs(Lighting:GetChildren()) do
				if child:IsA("PostEffect") or child:IsA("Atmosphere") then
					child:Destroy()
				end
			end

			-- Play leave sound
			playDimensionSound(225458887)

			-- Teleport player back to their original position before entering dimension
			if savedPosition then
				char.HumanoidRootPart.CFrame = savedPosition
				savedPosition = nil
			else
				char.HumanoidRootPart.CFrame = CFrame.new(currentDimensionPos - Vector3.new(0, 4000, 0))
			end
			isInside = false
			stopDimensionContainment()
			toolInstance.ToolTip = "Click to enter dimension"

			-- Clean up tool so it can be re-run cleanly
			toolInstance:Destroy()
			toolInstance = nil
			print("Dimension collapsed and removed.")
		end
	end)

	toolInstance.Parent = player.Backpack
	print("Dimension tool acquired!")
end

