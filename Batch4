local function bringRandomBoat()
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local boatsFolder = workspace:FindFirstChild("Boats")
	if not boatsFolder then
		print("Folder 'Boats' not found in Workspace!")
		return
	end

	local availableBoats = {}

	for _, boat in ipairs(boatsFolder:GetChildren()) do
		if boat:IsA("Model") then
			local seat = boat:FindFirstChildWhichIsA("VehicleSeat", true)
			local primaryPart = boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart", true)

			local isOccupied = seat and seat.Occupant ~= nil
			local isUnanchored = primaryPart and not primaryPart.Anchored

			if primaryPart and (primaryPart.Position - rootPart.Position).Magnitude <= 150 then
				if not isOccupied and isUnanchored then
					table.insert(availableBoats, boat)
				end
			end
		end
	end

	if #availableBoats == 0 then
		print("No nearby unanchored boats found within network range!")
		return
	end

	local selectedBoat = availableBoats[math.random(1, #availableBoats)]
	local targetCFrame = rootPart.CFrame + (rootPart.CFrame.LookVector * 15) + Vector3.new(0, 3, 0)

	for _, part in ipairs(selectedBoat:GetDescendants()) do
		if part:IsA("BasePart") and not part.Anchored then
			part.CanCollide = true
			part.CFrame = targetCFrame
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end

	print("Pulled nearby boat on server:", selectedBoat.Name)
end

local boatFlying = false
local flySpeed = 120
local flyConnection = nil

local function toggleBoatFly()
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or not humanoid.SeatPart or not humanoid.SeatPart:IsA("VehicleSeat") then
		print("You must sit in the driver's seat first!")
		return
	end

	local seat = humanoid.SeatPart
	local boatModel = seat:FindFirstAncestorOfClass("Model") or seat.Parent
	local mainPart = boatModel.PrimaryPart or seat

	boatFlying = not boatFlying

	if boatFlying then
		print("3D Boat Flight: ENABLED")

		local oldAttachment = mainPart:FindFirstChild("FlyAttachment")
		if oldAttachment then oldAttachment:Destroy() end

		local attachment = Instance.new("Attachment")
		attachment.Name = "FlyAttachment"
		attachment.Parent = mainPart

		local lv = Instance.new("LinearVelocity")
		lv.Name = "BoatLinearVelocity"
		lv.Attachment0 = attachment
		lv.MaxForce = math.huge
		lv.VectorVelocity = Vector3.zero
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.Parent = mainPart

		local ao = Instance.new("AlignOrientation")
		ao.Name = "BoatAlignOrientation"
		ao.Attachment0 = attachment
		ao.MaxTorque = math.huge
		ao.Responsiveness = 200
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Parent = mainPart

		local camera = workspace.CurrentCamera

		flyConnection = RunService.RenderStepped:Connect(function()
			if not boatFlying or not seat.Occupant then
				if flyConnection then flyConnection:Disconnect() end
				if attachment then attachment:Destroy() end
				boatFlying = false
				print("3D Boat Flight: DISABLED")
				return
			end

			for _, part in ipairs(boatModel:GetDescendants()) do
				if part:IsA("BasePart") then
					part.AssemblyLinearVelocity = Vector3.zero
				end
			end

			local moveDirection = Vector3.zero
			local camCFrame = camera.CFrame

			if seat.Throttle > 0 then
				moveDirection = moveDirection + camCFrame.LookVector
			elseif seat.Throttle < 0 then
				moveDirection = moveDirection - camCFrame.LookVector
			end

			if seat.Steer > 0 then
				moveDirection = moveDirection + camCFrame.RightVector
			elseif seat.Steer < 0 then
				moveDirection = moveDirection - camCFrame.RightVector
			end

			lv.VectorVelocity = moveDirection * flySpeed
			ao.CFrame = camCFrame
		end)
	else
		if flyConnection then flyConnection:Disconnect() end
		local att = mainPart:FindFirstChild("FlyAttachment")
		if att then att:Destroy() end
		print("3D Boat Flight: DISABLED")
	end
end

