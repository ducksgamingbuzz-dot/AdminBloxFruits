local function toggleAutoPunch(state)
	if state ~= nil then
		autoPunchActive = state
	else
		autoPunchActive = not autoPunchActive
	end

	if autoPunchActive then
		print("Auto M1 Punch: ENABLED")
		task.spawn(function()
			while autoPunchActive do
				-- Only fire when holding a tool
				local char = player.Character
				local hasTool = false
				if char then
					for _, child in ipairs(char:GetChildren()) do
						if child:IsA("Tool") then
							hasTool = true
							break
						end
					end
				end
				if hasTool then
					local args = { [1] = 0.0 }
					pcall(function()
						game:GetService("ReplicatedStorage").Modules.Net:FindFirstChild("RE/RegisterAttack"):FireServer(unpack(args))
					end)
				end
				task.wait()
			end
			print("Auto M1 Punch: DISABLED")
		end)
	else
		print("Auto M1 Punch: DISABLED")
	end
end

