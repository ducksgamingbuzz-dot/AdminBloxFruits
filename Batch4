end

-- ========== PERSISTENCE: Re-apply on respawn ==========

local function applyPersistence(character)
	if not character then return end
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then return end
	task.wait(0.5)

	if not data then return end

	if persistentState.level then
		local levelValue = data:FindFirstChild("Level")
		if levelValue and levelValue:IsA("ValueBase") then levelValue.Value = persistentState.level end
	end

	local stats = data:FindFirstChild("Stats")
	if stats and next(persistentState.stats) then
		for _, stat in stats:GetChildren() do
			if persistentState.stats[stat.Name] then
				local statLevel = stat:FindFirstChild("Level")
				if statLevel and statLevel:IsA("ValueBase") then
					statLevel.Value = persistentState.stats[stat.Name]
				end
			end
		end
	end

	if persistentState.beli then
		local beli = data:FindFirstChild("Beli")
		if beli and beli:IsA("ValueBase") then beli.Value = persistentState.beli end
	end
	if persistentState.fragments then
		local fragments = data:FindFirstChild("Fragments")
		if fragments and fragments:IsA("ValueBase") then fragments.Value = persistentState.fragments end
	end
	if persistentState.points then
		local points = data:FindFirstChild("Points")
		if points and points:IsA("ValueBase") then points.Value = persistentState.points end
	end
	if persistentState.race then
		local race = data:FindFirstChild("Race")
		if race and race:IsA("ValueBase") then race.Value = persistentState.race end
	end
	if persistentState.bounty then
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			local bountyHonor = leaderstats:FindFirstChild("Bounty/Honor")
			if bountyHonor and bountyHonor:IsA("ValueBase") then bountyHonor.Value = persistentState.bounty end
		end
	end

	applyHealthAndEnergy(character, stats)

	if persistentState.speed then
		local humanoidRef = character:FindFirstChildOfClass("Humanoid")
		if humanoidRef then humanoidRef.WalkSpeed = 16 * persistentState.speed end
	end
	if persistentState.size then
		character:ScaleTo(persistentState.size)
	end
end

player.CharacterAdded:Connect(applyPersistence)

-- ========== COMMAND PROCESSING ==========
-- Processes a command message. If fromCommandBar is true, also fires RemoteEvent to server.
-- This bypasses Roblox chat truncation for large numbers (e.g., /beli 999999999999).

local validRaces = {"Human", "Angel", "Shark", "Mink", "Cyborg", "Ghoul", "Draco"}

local function processCommand(message, fromCommandBar)
	if message:sub(1, 1) ~= "/" then return end
	if not isVerified then return end

	local args = message:sub(2):split(" ")
	local cmd = args[1]

	-- ===== CLIENT-SIDE COMMANDS =====
	if cmd == "s" then
		local lvl = tonumber(args[2])
		if lvl then setLevel(lvl) end

	elseif cmd == "setrace" then
		local raceName = args[2]
		if raceName then setRace(raceName) end

	elseif cmd == "st" then
		local amount = tonumber(args[2])
		local statName = args[3]
		if amount and statName then setStat(amount, statName) end

	elseif cmd == "ast" then
		local amount = tonumber(args[2])
		if amount then setAllStats(amount) end

	elseif cmd == "b" then
		local amount = tonumber(args[2])
		if amount then setBounty(amount) end

	elseif cmd == "setbeli" then
		local amount = tonumber(args[2])
		if amount then setBeli(amount) end

	elseif cmd == "beli2" then
		local amount = tonumber(args[2])
		if amount then addBeli(amount) end

	elseif cmd == "fragments" then
		local amount = tonumber(args[2])
		if amount then setFragments(amount) end

	elseif cmd == "fragments2" then
		local amount = tonumber(args[2])
		if amount then addFragments(amount) end

	elseif cmd == "points" then
		local amount = tonumber(args[2])
		if amount then setPoints(amount) end

	elseif cmd == "wspeed" then
		local multiplier = tonumber(args[2])
		if multiplier then setSpeed(multiplier) end

	elseif cmd == "rage" then
		fillRage()

	elseif cmd == "setsize" then
		local scale = tonumber(args[2])
		if scale then setSize(scale) end

	elseif cmd == "sizefruit" then
		local scale = tonumber(args[2])
		if scale then
			local character = player.Character
			if character then
				for _, v in character:GetChildren() do
					if v:IsA("Tool") and v:HasTag("Fruit") then
						v:ScaleTo(scale)
					end
				end
			end
		end

	elseif cmd == "exp" then
		local amount = tonumber(args[2])
		if amount then setExp(amount) end

	elseif cmd == "hakis" then
		local character = player.Character
		if character then
			for _, hakiName in ipairs({"KenHaki", "BusoHaki"}) do
				local haki = character:FindFirstChild(hakiName)
				if haki and haki:IsA("BoolValue") then haki.Value = true end
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:SetAttribute("KenHaki", true)
				humanoid:SetAttribute("BusoHaki", true)
			end
		end

	elseif cmd == "awtool" then
		local character = player.Character
		if character then
			local tool = character:FindFirstChildOfClass("Tool")
			if tool then
				local awakenedMoves = tool:FindFirstChild("AwakenedMoves")
				if awakenedMoves then
					for _, move in awakenedMoves:GetChildren() do
						if move:IsA("BoolValue") then move.Value = true end
					end
				end
			end
		end

	elseif cmd == "funattr" then
		player:SetAttribute("GANKS", nil)
		player:SetAttribute("NSUNS", 2)
		player:SetAttribute("GANKSvolley", nil)

	elseif cmd == "unfun" then
		player:SetAttribute("NSUNS", nil)
		player:SetAttribute("GANKS", nil)
		player:SetAttribute("GANKSvolley", nil)

	elseif cmd == "opfun" then
		player:SetAttribute("GANKS", true)
		player:SetAttribute("NSUNS", 2)
		player:SetAttribute("GANKSvolley", nil)

	elseif cmd == "unopfun" then
		player:SetAttribute("NSUNS", nil)
		player:SetAttribute("GANKS", nil)
		player:SetAttribute("GANKSvolley", nil)

	elseif cmd == "volley2" then
		player:SetAttribute("GANKS", nil)
		player:SetAttribute("NSUNS", 2)
		player:SetAttribute("GANKSvolley", 2)

	elseif cmd == "unvolley2" then
		player:SetAttribute("NSUNS", nil)
		player:SetAttribute("GANKS", nil)
		player:SetAttribute("GANKSvolley", nil)

	elseif cmd == "reducecooldown" then
		local num = tonumber(args[2])
		if num then
			player:SetAttribute("AllCooldown", num / 100)
		end

	elseif cmd == "fm" then
		Lighting.ClockTime = 14

	elseif cmd == "night" then
		Lighting.ClockTime = 0

	elseif cmd == "reset" then
		local character = player.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid.Health = 0 end
		end

	elseif cmd == "disguise" or cmd == "imp" then
		local targetName = args[2]
		if targetName then
			local character = player.Character
			if character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					local success, desc = pcall(function()
						return Players:GetHumanoidDescriptionFromUserId(
							Players:GetUserIdFromNameAsync(targetName)
						)
					end)
					if success and desc then humanoid:ApplyDescription(desc) end
				end
			end
		end

	elseif cmd == "rt2" then
		local character = player.Character
		if character then
			local raceEnergy = character:FindFirstChild("RaceEnergy")
			if raceEnergy and raceEnergy:IsA("ValueBase") then raceEnergy.Value = 1 end
		end
	end

	-- ===== ALWAYS FIRE TO SERVER IF FROM COMMAND BAR =====
	-- This bypasses Roblox chat truncation for large numbers.
	-- Chat commands already reach the server via player.Chatted.
	if fromCommandBar and adminRemote then
		adminRemote:FireServer(message)
	end
end

