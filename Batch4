-- Containment loop: keeps the player inside the dimension if they fall out
local function startDimensionContainment()
	dimensionContainmentActive = true
	task.spawn(function()
		while dimensionContainmentActive and currentDimensionFolder and currentDimensionPos do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local playerY = hrp.Position.Y
				local dimensionFloorY = currentDimensionPos.Y
				-- If player fell below the dimension floor, teleport them back
				if playerY < dimensionFloorY - 10 then
					hrp.CFrame = CFrame.new(currentDimensionPos + Vector3.new(0, 150, 0))
				end
			end
			task.wait(0.3)
		end
	end)
end

local function stopDimensionContainment()
	dimensionContainmentActive = false
end

