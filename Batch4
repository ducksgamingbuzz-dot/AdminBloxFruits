-- Start cycling through all fighting styles
local function startStyleCycle()
	if styleCycleActive then
		print("Style cycle is already running!")
		return
	end
	styleCycleActive = true
	print("Style cycle will start in 20 seconds...")
	task.spawn(function()
		task.wait(20)
		if not styleCycleActive then return end
		print("Style cycle started! Switching through all styles every 5 seconds.")
		-- Build ordered list of style keys
		local styleKeys = {}
		for key, _ in pairs(fightingStyles) do
			table.insert(styleKeys, key)
		end
		local index = 1
		while styleCycleActive do
			local styleKey = styleKeys[index]
			local serverString = fightingStyles[styleKey]
			if serverString then
				local commF = getCommF()
				if commF then
					local success, err = pcall(function()
