-- ========== HELPER FUNCTIONS ==========

local function applyHealthAndEnergy(character, stats)
	if not character or not character.Parent then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local energy = character:FindFirstChildOfClass("IntConstrainedValue")
	if stats then
		local defenseStat = stats:FindFirstChild("Defense")
		if defenseStat then
			local defenseLevel = defenseStat:FindFirstChild("Level")
			if defenseLevel and humanoid then
				humanoid.MaxHealth = 5 * (defenseLevel.Value + 19)
				humanoid.Health = humanoid.MaxHealth
			end
		end
		local meleeStat = stats:FindFirstChild("Melee")
		if meleeStat then
			local meleeLevel = meleeStat:FindFirstChild("Level")
			if meleeLevel and energy then
				local calculatedEnergy = 100 + (meleeLevel.Value - 1) * 5
				energy.MaxValue = calculatedEnergy
				energy.Value = calculatedEnergy
			end
		end
	end
	-- Clamp: Health must never exceed MaxHealth, Energy must never exceed MaxValue
	if humanoid and humanoid.Health > humanoid.MaxHealth then
		humanoid.Health = humanoid.MaxHealth
	end
	if energy and energy.Value > energy.MaxValue then
		energy.Value = energy.MaxValue
	end
end

-- ========== PERSISTENT HEALTH/ENERGY CLAMP ==========
-- Monitors the character and continuously enforces Health <= MaxHealth
-- and Energy.Value <= Energy.MaxValue. This catches any server replication
-- that tries to push Health/Energy above their max after a /s command.

local function attachHealthEnergyClamp(character)
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local energy = character:FindFirstChildOfClass("IntConstrainedValue")

	if humanoid then
		humanoid:GetPropertyChangedSignal("Health"):Connect(function()
			if humanoid.Health > humanoid.MaxHealth then
				humanoid.Health = humanoid.MaxHealth
			end
		end)
		humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
			if humanoid.Health > humanoid.MaxHealth then
				humanoid.Health = humanoid.MaxHealth
			end
		end)
	end

	if energy then
		energy:GetPropertyChangedSignal("Value"):Connect(function()
			if energy.Value > energy.MaxValue then
				energy.Value = energy.MaxValue
			end
		end)
		energy:GetPropertyChangedSignal("MaxValue"):Connect(function()
			if energy.Value > energy.MaxValue then
				energy.Value = energy.MaxValue
			end
		end)
	end
end

-- Attach clamp whenever the local player's character spawns
