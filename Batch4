local function syncStatsToServer(lvl, specificStat)
	local CommF_ = game.ReplicatedStorage:FindFirstChild("Remotes")
		and game.ReplicatedStorage.Remotes:FindFirstChild("CommF_")
	if not CommF_ then return end
	task.spawn(function()
		pcall(function()
			if specificStat then
				CommF_:InvokeServer("SetStatPoints", lvl, specificStat)
			else
				-- Server's setLevel now handles all stat levels + health/energy atomically
				CommF_:InvokeServer("SetLevel", lvl)
			end
		end)
	end)
end

local function setLevel(lvl)
	if not data or not lvl or lvl >= 9e17 then return end
	syncStatsToServer(lvl)
	local levelValue = data:FindFirstChild("Level")
	if levelValue and levelValue:IsA("ValueBase") then levelValue.Value = lvl end
	local stats = data:FindFirstChild("Stats")
	if stats then
		for _, stat in stats:GetChildren() do
			local statLevel = stat:FindFirstChild("Level")
			if statLevel and statLevel:IsA("ValueBase") then statLevel.Value = lvl end
		end
	end
	-- Health/energy are now handled server-side by setLevel;
	-- server changes replicate to client automatically.
	-- Apply locally as immediate visual feedback after a short delay
	-- so server replication doesn't override with stale values.
	task.delay(0.5, function()
		if player.Character and player.Character.Parent then
			applyHealthAndEnergy(player.Character, data and data:FindFirstChild("Stats"))
		end
	end)
	persistentState.level = lvl
	persistentState.stats = {}
	if stats then
		for _, stat in stats:GetChildren() do
			local statLevel = stat:FindFirstChild("Level")
			if statLevel and statLevel:IsA("ValueBase") then
				persistentState.stats[stat.Name] = lvl
			end
		end
	end
end

local function setStat(amount, statName)
	if not data or not amount then return end
	local stats = data:FindFirstChild("Stats")
	if not stats then return end
	local stat = stats:FindFirstChild(statName)
	if not stat then return end
	syncStatsToServer(amount, statName)
	local statLevel = stat:FindFirstChild("Level")
	if statLevel and statLevel:IsA("ValueBase") then statLevel.Value = amount end
	-- Server's setStatPoints handles health/energy; apply locally after delay
	task.delay(0.5, function()
		if player.Character and player.Character.Parent then
			applyHealthAndEnergy(player.Character, data and data:FindFirstChild("Stats"))
		end
	end)
	persistentState.stats[statName] = amount
end

local function setAllStats(amount)
	if not data or not amount then return end
	local stats = data:FindFirstChild("Stats")
	if not stats then return end
	syncStatsToServer(amount)
	for _, stat in stats:GetChildren() do
		local statLevel = stat:FindFirstChild("Level")
		if statLevel and statLevel:IsA("ValueBase") then statLevel.Value = amount end
	end
	-- Server's setLevel handles health/energy; apply locally after delay
	task.delay(0.5, function()
		if player.Character and player.Character.Parent then
			applyHealthAndEnergy(player.Character, data and data:FindFirstChild("Stats"))
		end
	end)
	persistentState.stats = {}
	for _, stat in stats:GetChildren() do
		local statLevel = stat:FindFirstChild("Level")
		if statLevel and statLevel:IsA("ValueBase") then
			persistentState.stats[stat.Name] = amount
		end
	end
end

local function setBeli(amount)
