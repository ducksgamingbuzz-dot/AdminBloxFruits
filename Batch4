-- ROTATE STYLE (1-min intervals, 5-min auto-stop)
------------------------------------------------

local rotateStyleActive = false

local function startRotateStyle()
	if rotateStyleActive then
		print("Rotate style is already running! Use /rotatestylestop to stop it.")
		return
	end
	rotateStyleActive = true
	print("Rotate style started! Switching through all styles every 1 minute for 5 minutes.")
	task.spawn(function()
		-- Build ordered list of style keys
		local styleKeys = {}
		for key, _ in pairs(fightingStyles) do
			table.insert(styleKeys, key)
		end
		table.sort(styleKeys) -- alphabetical for consistent order

		local index = 1
		local elapsed = 0
		local duration = 300 -- 5 minutes total
		local interval = 60 -- 1 minute per style

		while rotateStyleActive and elapsed < duration do
			local styleKey = styleKeys[index]
			local serverString = fightingStyles[styleKey]
			if serverString then
				local commF = getCommF()
				if commF then
					local success, err = pcall(function()
						commF:InvokeServer(serverString, false)
					end)
					if success then
						print("[RotateStyle] Switched to " .. styleKey .. " (" .. serverString .. ")")
					else
						warn("[RotateStyle] Error for " .. styleKey .. ": " .. tostring(err))
					end
				end
			end

			local remaining = math.floor((duration - elapsed) / interval)
			print("[RotateStyle] Next style in 60 seconds... (" .. remaining .. " rotations remaining)")

			-- Wait 1 minute, checking active flag every second so we can stop early
			local waited = 0
			while rotateStyleActive and waited < interval do
				task.wait(1)
				waited = waited + 1
			end

			elapsed = elapsed + interval
			index = index + 1
			if index > #styleKeys then index = 1 end
		end

		rotateStyleActive = false
		if elapsed >= duration then
			print("[RotateStyle] 5 minutes completed. Rotate style stopped automatically.")
		else
			print("[RotateStyle] Stopped early.")
		end
	end)
end

local function stopRotateStyle()
	rotateStyleActive = false
	print("[RotateStyle] Stopped.")
end

