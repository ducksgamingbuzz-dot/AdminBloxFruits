	currentDimensionFolder.Name = "MassiveGodPalaceDimension"
	currentDimensionFolder.Parent = workspace

	-- Helper function for building palace structures
	local function p(size, pos, color, material, transparency, shape)
		local part = Instance.new("Part")
		part.Size = size
		part.Position = pos
		part.Anchored = true
		-- Reduce brightness: downgrade Gold Neon to Metal (non-glowing)
		if material == Enum.Material.Neon and color == "Gold" then
			material = Enum.Material.Metal
		end
		-- Mute bright white marble to a dimmer, more elegant tone
		if color == "Institutional white" then
			color = "Light stone grey"
		end
		part.BrickColor = BrickColor.new(color)
		part.Material = material
		part.Transparency = transparency or 0
		if shape then part.Shape = shape end
		part.Parent = currentDimensionFolder
		return part
